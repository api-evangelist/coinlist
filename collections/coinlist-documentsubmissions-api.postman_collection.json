          "name": "Create a document signing submission for the authenticated partner and user",
          "request": {
            "name": "Create a document signing submission for the authenticated partner and user",
            "description": {
              "content": "Creates a signing submission for the given document type (e.g. a W-8BEN tax certification) for the current entity. The signing link is emailed to the user. Re-posting acts as a resend/re-sign where the document state allows it. The submitted PII pre-fills the form and is forwarded to Passport, never persisted by Frontline.",
              "type": "text/plain"
            },
            "url": {
