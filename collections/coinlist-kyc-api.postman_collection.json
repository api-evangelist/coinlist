        {
          "id": "890374bd-47db-465e-a9c4-2e904c2f0fa1",
          "name": "Generate a Sumsub KYC access token",
          "request": {
            "name": "Generate a Sumsub KYC access token",
            "description": {
              "content": "Generates a short-lived Sumsub WebSDK access token for the current user so an identity verification flow can be started. Requires a user-scoped access token (authorization code grant); partner-only tokens (client credentials grant) are rejected.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "kyc-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "redirect_uri",
                  "value": "/oauth/token"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "level_name",
                  "value": "Sorting_KYC_Level",
                  "description": "The Sumsub verification level to start. Determines which screens the Sumsub WebSDK shows."
                },
                {
                  "disabled": false,
                  "key": "reset",
                  "value": "false",
                  "description": "Reset the Sumsub applicant before issuing the token, so an already-approved level can be executed again (e.g. to update stale PII). Send the kyc_reset value from the requirement status. Must not be sent when refreshing an expired token mid-flow, or the user's in-progress submission is wiped."
                }
              ]
            }
          },
          "response": [
            {
              "id": "5ae0c459-862c-4204-9837-5cbbc5fb8297",
              "name": "Successful response.",
