{
  "opencollection": "1.0.0",
  "info": {
    "name": "Frontline DocumentSubmissions Requirements API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Requirements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List requirements for all options of an offer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coinlist.co/v1/offers/:offer_id/requirements",
            "params": [
              {
                "name": "offer_id",
                "value": "",
                "type": "path",
                "description": "The offer ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List requirements for all options of an offer"
        },
        {
          "info": {
            "name": "List requirement statuses for all options of an offer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coinlist.co/v1/offers/:offer_id/requirements/statuses",
            "params": [
              {
                "name": "offer_id",
                "value": "",
                "type": "path",
                "description": "The offer ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List requirement statuses for all options of an offer"
        }
      ]
    }
  ],
  "bundled": true
}